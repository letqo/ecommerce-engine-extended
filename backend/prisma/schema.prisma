generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

model Store {
  id                 String   @id @default(uuid())
  name               String   @default("Store")
  description        String?
  logoUrl            String?
  faviconUrl         String?
  primaryColor       String   @default("#000000")
  secondaryColor     String   @default("#ffffff")
  accentColor        String   @default("#6366f1")
  currency           String   @default("USD")
  currencySymbol     String   @default("$")
  timezone           String   @default("UTC")
  metaTitle          String?
  metaDescription    String?
  contactEmail       String?
  contactPhone       String?
  emailFromName      String?
  emailFromAddress   String?
  address            String?
  socialLinks        Json?
  shippingPolicy     String?
  returnPolicy       String?
  privacyPolicy      String?
  termsOfService     String?
  aboutUs            String?
  faqContent         String?
  announcementText   String?
  announcementLink   String?
  announcementActive Boolean  @default(false)
  heroHeadline       String?
  heroSubtext        String?
  heroCtaText        String?
  heroCtaLink        String?
  heroBannerUrl      String?
  homeSections       Json?
  footerColumns      Json?
  activeTheme             String    @default("default")
  aliexpressAccessToken   String?
  aliexpressTokenExpiry   DateTime?
  shipToCountry           String    @default("US")
  targetMarkets           String[]  @default(["DE", "FR", "IT", "ES", "US"])
  sourcingCurrency        String    @default("USD")
  // Multiplier applied to a supplier's landed cost (item + shipping) to set the selling price
  // when importing a product and no per-import markup is explicitly given. Editable in Settings;
  // a manual per-import override in the Import Products page always takes precedence over this.
  defaultImportMarkup     Float     @default(2.5)
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  products         Product[]
  categories       Category[]
  orders           Order[]
  customers        Customer[]
  carts            Cart[]
  discounts        Discount[]
  shippingZones    ShippingZone[]
  emailSubscribers EmailSubscriber[]
  abandonedCarts   AbandonedCart[]
  analyticsEvents  AnalyticsEvent[]
  pages            Page[]
  assets           Asset[]
  blogPosts        BlogPost[]
  themes           Theme[]
  reviews          Review[]
  setupAssistantSession SetupAssistantSession?
  translations     StoreTranslation[]
}

model SetupAssistantSession {
  id        String   @id @default(uuid())
  storeId   String   @unique
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  messages  Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model StoreTranslation {
  id              String   @id @default(uuid())
  storeId         String
  store           Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  locale          String
  aboutUs         String?
  shippingPolicy  String?
  returnPolicy    String?
  privacyPolicy   String?
  termsOfService  String?
  faqContent      String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([storeId, locale])
}

model Theme {
  id           String              @id @default(uuid())
  storeId      String?
  store        Store?              @relation(fields: [storeId], references: [id])
  name         String
  slug         String
  description  String?
  vars         Json
  css          String              @default("")
  sections     Json?
  isBuiltIn    Boolean             @default(false)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  translations ThemeTranslation[]

  @@unique([storeId, slug])
  @@index([storeId])
}

model ThemeTranslation {
  id        String   @id @default(uuid())
  themeId   String
  theme     Theme    @relation(fields: [themeId], references: [id], onDelete: Cascade)
  locale    String
  strings   Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([themeId, locale])
}

model Admin {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String
  firstName    String
  lastName     String
  role         AdminRole @default(OWNER)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

enum AdminRole {
  OWNER
  MANAGER
  STAFF
}

model Category {
  id          String     @id @default(uuid())
  storeId     String?
  store       Store?     @relation(fields: [storeId], references: [id])
  name        String
  slug        String
  description String?
  imageUrl    String?
  parentId    String?
  parent      Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryTree")
  products    Product[]
  sortOrder   Int        @default(0)
  isVisible   Boolean    @default(true)
  translations CategoryTranslation[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@unique([storeId, slug])
  @@index([storeId, isVisible, parentId])
}

model CategoryTranslation {
  id          String   @id @default(uuid())
  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  locale      String
  name        String?
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([categoryId, locale])
}

model Product {
  id               String           @id @default(uuid())
  storeId          String?
  store            Store?           @relation(fields: [storeId], references: [id])
  title            String
  slug             String
  description      String?
  shortDescription String?
  status           ProductStatus    @default(DRAFT)
  categoryId       String?
  category         Category?        @relation(fields: [categoryId], references: [id])
  images           ProductImage[]
  variants         ProductVariant[]
  options          ProductOption[]
  tags             String[]
  vendor           String?
  productType      String?
  isFeatured       Boolean          @default(false)
  metaTitle        String?
  metaDescription  String?
  weight           Float?
  videoUrl                 String?
  cjProductId              String?
  cjProductUrl             String?
  aliexpressProductId      String?
  listVariantsIndividually Boolean          @default(false)
  deliveryMinDays          Int?
  deliveryMaxDays          Int?
  lastSyncedAt             DateTime?
  syncAlert                String?
  // Target markets (from Store.targetMarkets) that this listing did NOT ship to as of import
  // time — a snapshot, not kept fresh by the daily sync (see SUPPLIER_API_NOTES.md). Use
  // createdAt as the "as of" date when displaying this.
  unavailableMarkets       String[]         @default([])
  // Human-readable snapshot from import time flagging unusually slow delivery (e.g. "Slow
  // delivery: ~60 days") or a big swing in delivery time/cost between target markets — same
  // "not rechecked automatically" caveat as unavailableMarkets above.
  deliveryNote             String?
  reviews                  Review[]
  translations             ProductTranslation[]
  createdAt                DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@unique([storeId, slug])
  @@index([storeId, status])
  @@index([storeId, isFeatured])
  @@index([storeId, status, createdAt])
  @@index([categoryId])
}

model ProductTranslation {
  id               String   @id @default(uuid())
  productId        String
  product          Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  locale           String
  title            String?
  shortDescription String?
  description      String?
  metaTitle        String?
  metaDescription  String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([productId, locale])
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

model ProductImage {
  id        String   @id @default(uuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  altText   String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
}

model ProductOption {
  id        String               @id @default(uuid())
  productId String
  product   Product              @relation(fields: [productId], references: [id], onDelete: Cascade)
  name      String
  values    ProductOptionValue[]
  sortOrder Int                  @default(0)
}

model ProductOptionValue {
  id       String        @id @default(uuid())
  optionId String
  option   ProductOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  value    String
}

model ProductVariant {
  id             String      @id @default(uuid())
  productId      String
  product        Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku            String?     @unique
  title          String
  options        Json
  price          Float
  compareAtPrice Float?
  costPerItem    Float?
  inventoryQty   Int         @default(0)
  trackInventory Boolean     @default(true)
  allowBackorder Boolean     @default(false)
  weight         Float?
  imageUrl       String?
  isDefault      Boolean     @default(false)
  barcode        String?
  cjVariantId        String?
  aliexpressSkuId    String?
  aliexpressSkuAttr  String?
  orderItems     OrderItem[]
  cartItems      CartItem[]
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@index([productId])
}

model Customer {
  id               String            @id @default(uuid())
  storeId          String?
  store            Store?            @relation(fields: [storeId], references: [id])
  email            String
  passwordHash     String?
  firstName        String?
  lastName         String?
  phone            String?
  acceptsMarketing Boolean           @default(false)
  isVerified       Boolean           @default(false)
  verifyToken      String?
  resetToken       String?
  resetTokenExpiry DateTime?
  addresses        CustomerAddress[]
  orders           Order[]
  cart             Cart?
  reviews          Review[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@unique([storeId, email])
  @@index([storeId])
}

model CustomerAddress {
  id         String   @id @default(uuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  firstName  String
  lastName   String
  company    String?
  address1   String
  address2   String?
  city       String
  province   String?
  postalCode String
  country    String
  phone      String?
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Cart {
  id         String     @id @default(uuid())
  storeId    String?
  store      Store?     @relation(fields: [storeId], references: [id])
  customerId String?    @unique
  customer   Customer?  @relation(fields: [customerId], references: [id])
  sessionId  String?    @unique
  items      CartItem[]
  couponCode String?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
}

model CartItem {
  id        String         @id @default(uuid())
  cartId    String
  cart      Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id])
  quantity  Int
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@unique([cartId, variantId])
}

model Discount {
  id             String       @id @default(uuid())
  storeId        String?
  store          Store?       @relation(fields: [storeId], references: [id])
  code           String
  type           DiscountType
  value          Float
  minOrderAmount Float?
  maxUses        Int?
  usedCount      Int          @default(0)
  isActive       Boolean      @default(true)
  startsAt       DateTime?
  endsAt         DateTime?
  orders         Order[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([storeId, code])
}

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
  FREE_SHIPPING
}

model Order {
  id                    String          @id @default(uuid())
  storeId               String?
  store                 Store?          @relation(fields: [storeId], references: [id])
  orderNumber           Int             @unique @default(autoincrement())
  customerId            String?
  customer              Customer?       @relation(fields: [customerId], references: [id])
  guestEmail            String?
  status                OrderStatus     @default(PENDING)
  paymentStatus         PaymentStatus   @default(UNPAID)
  fulfillmentStatus     FulfillStatus   @default(UNFULFILLED)
  items                 OrderItem[]
  subtotal              Float
  discountAmount        Float           @default(0)
  shippingAmount        Float           @default(0)
  taxAmount             Float           @default(0)
  total                 Float
  discountId            String?
  discount              Discount?       @relation(fields: [discountId], references: [id])
  currency              String          @default("USD")
  shippingAddress       Json
  billingAddress        Json?
  shippingMethod        String?
  trackingNumber        String?
  trackingUrl           String?
  // First time trackingNumber was set — the anchor damage-claim windows count from,
  // since we don't reliably know an exact delivery date (see DamageClaim below).
  shippedAt             DateTime?
  notes                 String?
  paymentMethod         String?
  stripePaymentIntentId String?
  cjOrderId             String?
  cjOrderStatus         String?
  aliexpressOrderId     String?
  aliexpressOrderStatus String?
  timeline              OrderTimeline[]
  refunds               Refund[]
  claims                DamageClaim[]
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  @@index([storeId, status])
  @@index([storeId, customerId])
  @@index([orderNumber])
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  UNPAID
  PAID
  PARTIALLY_REFUNDED
  FULLY_REFUNDED
  FAILED
}

enum FulfillStatus {
  UNFULFILLED
  PARTIALLY_FULFILLED
  FULFILLED
}

model OrderItem {
  id              String         @id @default(uuid())
  orderId         String
  order           Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variantId       String
  variant         ProductVariant @relation(fields: [variantId], references: [id])
  title           String
  variantTitle    String
  sku             String?
  price           Float
  quantity        Int
  imageUrl        String?
  reviewToken     String?        @unique
  reviewTokenUsed Boolean        @default(false)
  createdAt       DateTime       @default(now())

  @@index([variantId])
}

model OrderTimeline {
  id        String   @id @default(uuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  message   String
  createdBy String   @default("system")
  createdAt DateTime @default(now())
}

model Refund {
  id             String   @id @default(uuid())
  orderId        String
  order          Order    @relation(fields: [orderId], references: [id])
  amount         Float
  reason         String?
  stripeRefundId String?
  createdAt      DateTime @default(now())
}

// A customer-reported damage/problem claim on an order. No physical return is
// expected — for AliExpress/CJ dropshipped goods, shipping a broken item back to
// the supplier almost never covers its own freight cost. The claim's photos are
// instead used both for the AI assessment below and as evidence the store owner
// forwards to the supplier's own buyer-protection/after-sales process separately.
model DamageClaim {
  id           String      @id @default(uuid())
  orderId      String
  order        Order       @relation(fields: [orderId], references: [id])
  reason       String
  description  String
  photos       String[]
  status       ClaimStatus @default(PENDING)
  resolution   String?
  aiAssessment String?
  aiConfident  Boolean?
  refundId     String?
  resolvedAt   DateTime?
  resolvedBy   String?
  // Separate from the customer-facing resolution above — tracks whether the store
  // owner has pursued getting the wholesale cost back from the supplier (CJ/AliExpress
  // have no API for this; it's filed manually). One of: filed, reimbursed, not_pursuing.
  supplierClaimStatus String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([orderId])
  @@index([status])
}

enum ClaimStatus {
  PENDING
  AUTO_APPROVED
  NEEDS_REVIEW
  APPROVED
  DENIED
}

model ShippingZone {
  id        String         @id @default(uuid())
  storeId   String?
  store     Store?         @relation(fields: [storeId], references: [id])
  name      String
  countries String[]
  rates     ShippingRate[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
}

model ShippingRate {
  id             String       @id @default(uuid())
  zoneId         String
  zone           ShippingZone @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  name           String
  price          Float
  minOrderAmount Float?
  maxOrderAmount Float?
  isFree         Boolean      @default(false)
  estimatedDays  String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model EmailSubscriber {
  id               String   @id @default(uuid())
  storeId          String?
  store            Store?   @relation(fields: [storeId], references: [id])
  email            String
  firstName        String?
  source           String?
  isActive         Boolean  @default(true)
  unsubscribeToken String   @unique @default(uuid())
  createdAt        DateTime @default(now())

  @@unique([storeId, email])
}

model AbandonedCart {
  id             String    @id @default(uuid())
  storeId        String?
  store          Store?    @relation(fields: [storeId], references: [id])
  email          String
  cartData       Json
  reminderSentAt DateTime?
  recoveredAt    DateTime?
  createdAt      DateTime  @default(now())
}

model AnalyticsEvent {
  id         String   @id @default(uuid())
  storeId    String?
  store      Store?   @relation(fields: [storeId], references: [id])
  type       String
  productId  String?
  orderId    String?
  customerId String?
  sessionId  String?
  value      Float?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([type])
  @@index([createdAt])
}

model Page {
  id              String   @id @default(uuid())
  storeId         String?
  store           Store?   @relation(fields: [storeId], references: [id])
  title           String
  slug            String
  body            String
  isVisible       Boolean  @default(true)
  metaTitle       String?
  metaDescription String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([storeId, slug])
}

model Asset {
  id        String   @id @default(uuid())
  storeId   String?
  store     Store?   @relation(fields: [storeId], references: [id])
  filename  String
  url       String
  mimeType  String
  size      Int
  folder    String   @default("general")
  createdAt DateTime @default(now())
}

model Review {
  id         String       @id @default(cuid())
  storeId    String?
  store      Store?       @relation(fields: [storeId], references: [id])
  productId  String
  product    Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  customerId String?
  customer   Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)
  authorName String
  rating     Int
  title      String?
  body       String?
  status     ReviewStatus @default(PENDING)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@index([productId, status])
  @@index([storeId, status])
  @@unique([productId, customerId])
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

model BlogPost {
  id             String    @id @default(cuid())
  storeId        String?
  store          Store?    @relation(fields: [storeId], references: [id])
  title          String
  slug           String
  content        String    @default("")
  excerpt        String?
  coverImage     String?
  status         String    @default("DRAFT")
  publishedAt    DateTime?
  seoTitle       String?
  seoDescription String?
  tags           String[]
  readingTime    Int       @default(1)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([storeId, slug])
  @@index([storeId, status])
  @@index([storeId, publishedAt])
}
